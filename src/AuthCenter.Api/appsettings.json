{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AuthCenter;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "AuthCenter",
    "Audience": "AuthCenter.Clients",
    "SigningKey": "REPLACE_WITH_SECURE_KEY_MIN_32_CHARS_LONG",
    "RsaPrivateKeyPem": "REPLACE_WITH_RSA_PRIVATE_KEY_PEM",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Authentication": {
    "Google": {
      "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@authcenter.local",
    "FromName": "AuthCenter"
  },
  "Mfa": {
    "EncryptionKey": "REPLACE_WITH_32_OR_MORE_RANDOM_CHARS",
    "PreviousEncryptionKeys": [],
    "TotpIssuer": "AuthCenter",
    "MfaTokenExpirySeconds": 300
  },
    "Passkeys": {
    "RelyingPartyId": "REPLACE_WITH_PUBLIC_AUTHCENTER_HOST",
      "AllowedOrigins": [ "https://REPLACE_WITH_PUBLIC_AUTHCENTER_HOST" ],
      "CeremonyMinutes": 5,
      "ReauthenticationMinutes": 5,
      "MaxCredentialsPerUser": 10
    },
    "AdaptiveAuth": {
      "SignalHashKey": "REPLACE_WITH_KEY_VAULT_SECRET",
      "ObservationRetentionDays": 30,
      "FailedEventWindowMinutes": 15,
      "FailedEventThreshold": 5,
      "MaximumTravelSpeedKmh": 900
    },
  "ActionLinks": {
    "DefaultBaseUrl": "https://REPLACE_WITH_PUBLIC_CLIENT_ORIGIN",
    "ApplicationBaseUrls": {}
  },
  "Oidc": {
    "PublicOrigin": "https://REPLACE_WITH_PUBLIC_AUTHCENTER_ORIGIN"
  },
  "DataProtection": {
    "ApplicationName": "AuthCenter",
    "KeyEncryptionCertificateBase64": "REPLACE_WITH_BASE64_PKCS12_CERTIFICATE",
    "KeyEncryptionCertificatePassword": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Retention": {
    "Enabled": true,
    "IntervalHours": 6,
    "TokenHistoryDays": 30,
    "AuditLogDays": 365,
    "BatchSize": 500
  },
  "RateLimiting": {
    "DistributedEnabled": true
  },
  "HealthChecks": {
    "ReadinessHost": ""
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
