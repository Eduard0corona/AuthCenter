<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AuthCenter.Application\AuthCenter.Application.csproj" />
    <ProjectReference Include="..\AuthCenter.Infrastructure\AuthCenter.Infrastructure.csproj" />
    <ProjectReference Include="..\AuthCenter.Contracts\AuthCenter.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>AuthCenter.Api.Development</UserSecretsId>
    <AdminFrontendRoot>$(MSBuildProjectDirectory)\..\AuthCenter.Admin</AdminFrontendRoot>
  </PropertyGroup>

  <Target Name="BuildAdminFrontend" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(SkipAdminFrontendBuild)' != 'true' and Exists('$(AdminFrontendRoot)\package-lock.json')">
    <Exec WorkingDirectory="$(AdminFrontendRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(AdminFrontendRoot)" Command="npm run build" />
  </Target>

  <Target Name="IncludeAdminFrontendInPublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildAdminFrontend"
          Condition="Exists('$(AdminFrontendRoot)\dist\index.html')">
    <ItemGroup>
      <_AdminFrontendAsset Include="$(AdminFrontendRoot)\dist\**\*" />
      <ResolvedFileToPublish Include="@(_AdminFrontendAsset)">
        <RelativePath>wwwroot\admin-v2\%(_AdminFrontendAsset.RecursiveDir)%(_AdminFrontendAsset.Filename)%(_AdminFrontendAsset.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
