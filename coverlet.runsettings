<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for dotnet test with these settings: AuthCenter's own code, without tests,
     samples, EF migrations (generated) or the compiler's generated files. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[AuthCenter.*]*</Include>
          <Exclude>[AuthCenter.*Tests]*,[AuthCenter.Sample*]*</Exclude>
          <ExcludeByFile>**/Persistence/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
