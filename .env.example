# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# Generate the RSA key with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# and paste it below between double quotes, keeping the line breaks. Compose reads multi-line
# values only when they are double-quoted.

MSSQL_SA_PASSWORD=Local_Dev_Password_1
JWT_SIGNING_KEY=replace-with-at-least-64-random-characters-for-non-development-use
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FULL_NAME=System Administrator

JWT_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
paste
the
key
here
-----END PRIVATE KEY-----"
