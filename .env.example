# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# Generate the RSA key with `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048`.
# Store the complete PEM only in the ignored .env file; never put real key material in this template.

MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
JWT_SIGNING_KEY=replace-with-at-least-64-random-characters-for-non-development-use
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ACTION_LINKS_BASE_URL=http://localhost:3000
OIDC_PUBLIC_ORIGIN=http://localhost:8080
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
SEED_ADMIN_FULL_NAME=Example Administrator

JWT_RSA_PRIVATE_KEY_PEM=
